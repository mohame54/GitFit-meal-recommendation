# Supabase
SUPABASE_URL=https://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=..
# Allowed JWT alg values (comma-separated). ECC P-256 → ES256.
# Token header alg must be in this list before verification.
SUPABASE_JWT_ALGORITHMS=ES256
# JWT secret only when HS256 is listed above (local / legacy projects).
# ES256/RS256 verify via SUPABASE_URL JWKS instead.
# SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Example allowing both ECC and legacy HMAC: SUPABASE_JWT_ALGORITHMS=ES256,HS256
# Optional API gate — when set, clients must send matching X-Api-Key
# API_KEY=dev-secret-key
# Optional CORS allow-list (comma-separated). Unset echoes the request Origin.
# CORS_ORIGINS=http://localhost:5173

# LLM models (provider is inferred from the name)
# Accepts bare names or full Mastra ids:
#   gemini-2.5-flash
#   google/gemini-2.5-flash
# Optional override when inference is ambiguous (e.g. Azure):
# LLM_PROVIDER=google
NUTRIENT_LLM_NAME=gemini-2.5-flash
FEEDBACK_LLM_NAME=gemini-2.5-flash
MAIN_AGENT_LLM_NAME=gemini-2.5-flash
ONBOARDING_AGENT_LLM_NAME=gemini-2.5-flash
RECIPE_GENERATION_LLM_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=5000

# API keys — set the key for each provider you use.
# Mastra primary names (recommended):
GOOGLE_API_KEY=....
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# AZURE_API_KEY=your-azure-key
# COHERE_API_KEY=your-cohere-key
# DEEPSEEK_API_KEY=your-deepseek-key
#
# Aliases also work and are normalized at startup:
# GEMINI_API_KEY=your-google-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-key

# Spoonacular — only needed for ingestion (caching into Postgres).
# Recommendations never call Spoonacular at request time.
SPOONACULAR_API_KEY=....

# Server
# Local only. Cloud Run injects PORT from the container port (8000).
PORT=3000
# dev | development | prod | production
NODE_ENV=dev
LOG_LEVEL=debug

# Versioning
APP_VERSION=0.1.0
